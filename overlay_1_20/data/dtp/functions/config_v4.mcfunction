# Nowe teleporty (dach Netheru, środek oceanu), więc nowe domyślne szanse:
# 70% zwykły teleport, reszta po równo. Odpala się raz na świat.
data modify storage dtp:config w_random set value 70
data modify storage dtp:config w_sky set value 6
data modify storage dtp:config w_lava set value 6
data modify storage dtp:config w_dimension set value 6
data modify storage dtp:config w_roof set value 6
data modify storage dtp:config w_ocean set value 6
data modify storage dtp:config version set value 4
