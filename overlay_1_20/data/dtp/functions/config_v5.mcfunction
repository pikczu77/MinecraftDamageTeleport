# Nowe teleporty (Deep Dark, creeper-towarzysz), więc nowe domyślne szanse:
# 65% zwykły teleport, każdy z 7 śmiesznych po 5%. Odpala się raz na świat.
data modify storage dtp:config w_random set value 65
data modify storage dtp:config w_sky set value 5
data modify storage dtp:config w_lava set value 5
data modify storage dtp:config w_dimension set value 5
data modify storage dtp:config w_roof set value 5
data modify storage dtp:config w_ocean set value 5
data modify storage dtp:config w_deep_dark set value 5
data modify storage dtp:config w_creeper set value 5
data modify storage dtp:config version set value 5
